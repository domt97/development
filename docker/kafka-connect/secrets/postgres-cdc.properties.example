# Copy to postgres-cdc.properties (git-ignored) and fill in. Read by Kafka Connect's FileConfigProvider
# (mounted at /opt/connect-secrets), so the values never appear in the connector config, _connect_configs or git.
# Prefer a dedicated replication user. The publications are created by script, so it needs no ownership; the grants
# it needs are listed in docs/connectors.md.
user=postgres
password=change-me
