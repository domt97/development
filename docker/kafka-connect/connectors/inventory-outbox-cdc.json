{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "${file:/opt/connect-secrets/postgres-cdc.properties:user}",
  "database.password": "${file:/opt/connect-secrets/postgres-cdc.properties:password}",
  "database.dbname": "inventory",
  "topic.prefix": "inventory",
  "plugin.name": "pgoutput",
  "slot.name": "debezium_inventory_slot",
  "publication.name": "debezium_inventory_publication",
  "publication.autocreate.mode": "disabled",
  "snapshot.mode": "never",
  "table.include.list": "inventory.outbox_events,inventory.debezium_heartbeat",
  "tombstones.on.delete": "false",
  "heartbeat.interval.ms": "60000",
  "heartbeat.action.query": "WITH pruned AS (DELETE FROM inventory.debezium_heartbeat WHERE beat_at < now() - interval '1 hour') INSERT INTO inventory.debezium_heartbeat (beat_at) VALUES (now())",
  "topic.creation.default.partitions": "6",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.retention.ms": "1209600000",
  "header.converter": "org.apache.kafka.connect.storage.SimpleHeaderConverter",
  "predicates": "isHeartbeatTable,isOutbox",
  "predicates.isHeartbeatTable.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isHeartbeatTable.pattern": "inventory\\.inventory\\.debezium_heartbeat",
  "predicates.isOutbox.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isOutbox.pattern": "inventory\\.inventory\\.outbox_events",
  "transforms": "dropHeartbeat,outbox",
  "transforms.dropHeartbeat.type": "org.apache.kafka.connect.transforms.Filter",
  "transforms.dropHeartbeat.predicate": "isHeartbeatTable",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.predicate": "isOutbox",
  "transforms.outbox.route.by.field": "event_type",
  "transforms.outbox.route.topic.replacement": "${routedByValue}",
  "transforms.outbox.table.field.event.key": "aggregate_id",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.fields.additional.placement": "correlation_context:header:correlationContext"
}
